NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bdgce_real_demo
JWT_SECRET=generate-a-random-secret
EXECUTION_MODE=real_gpu
FINAL_DEMO=true
ENABLE_DEV_ROUTES=false
BLOCKCHAIN_DEMO_MODE=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=local-hardhat-operator-account-1
DEMO_CONSUMER_PRIVATE_KEY=local-hardhat-consumer-account-2
ESCROW_CONTRACT_ADDRESS=address-printed-by-deployment
RATE_WEI_PER_MINUTE=1000000000000000
# Optional absolute Python path for backend numerical verification
PYTHON_EXECUTABLE=python
# Backend-only local Kubo API. Leave empty to use local files exclusively.
IPFS_API_URL=http://127.0.0.1:5001
