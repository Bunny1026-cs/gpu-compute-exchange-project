# Paper / research (keep out of repo)
# NOTE (P0-5): patterns WITHOUT a leading "/" match at every depth. The former
# "scripts/" rule therefore also excluded backend/scripts/ and
# blockchain/scripts/, which package.json and the blockchain Dockerfile need.
# "/scripts/" is anchored to the repository root so only the root-level
# research folder is ignored.
paper-revised/
results-assets/
/scripts/
BDGCE_paper_revised.tex
*.tex
*.cls
*.bbl
*.blg
*.aux
*.bib

# Misc
*.tmp
*.bak
coverage/
.nyc_output/
.npm-cache/

# Genuine local compute artifacts and private runtime configuration
backend/results/
worker/results/
runtime/

backend/results.reset-*/
worker/results.reset-*/
.playwright-mcp/

# Local checkpoints, temporary tools/backups, and finalized paper exports
/.local-checkpoints/
/tmp/
/output/
