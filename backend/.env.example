# ============================================================
# GPU Compute Exchange — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# ── Database — MongoDB Atlas ──────────────────────────────────
# Local:   mongodb://localhost:27017/gpuexchange
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gpuexchange?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/gpuexchange?retryWrites=true&w=majority&appName=Cluster0

# ── JWT Auth ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_INTERVAL_MS=5000

# ── Blockchain — Local Hardhat Demo (Phase 7) ────────────────
# ⚠️  WARNING: This section uses LOCAL DEMO credentials ONLY.
#   All ETH is Hardhat test ETH with ZERO real-world value.
#   NEVER use these keys on mainnet or any public network.
#   NEVER put VITE_ prefixes on these variables (frontend must never see them).
#
# Workflow:
#   1. Terminal 1: cd blockchain && npx hardhat node
#   2. Terminal 2: cd blockchain && npx hardhat run scripts/deploy.js --network localhost
#   3. Copy the printed contract address and keys into this file
#   4. Terminal 3: cd backend && node index.js
#
# ⚠️  These values change every time you restart the Hardhat node and redeploy.

# URL of the local persistent Hardhat node
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Hardhat Account[1] — backend operator wallet
# Source: Hardhat's well-known public test accounts (public documentation)
# ZERO real value — local Hardhat only
BLOCKCHAIN_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Address of the deployed GPUComputeEscrow contract
# Update this every time you redeploy (restart Hardhat node)
ESCROW_CONTRACT_ADDRESS=<paste-contract-address-from-deploy-script>

# ── Blockchain Demo Mode ──────────────────────────────────────
# Set to true to enable demo escrow (registerJob + depositFunds via demo consumer)
# NEVER set to true on production or public networks
BLOCKCHAIN_DEMO_MODE=true

# Hardhat Account[2] — demo consumer wallet (LOCAL DEMO ONLY, ZERO real value)
# Only used when BLOCKCHAIN_DEMO_MODE=true
DEMO_CONSUMER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Demo escrow amount in wei (0.001 ETH = 1000000000000000 wei)
# This is TEST ETH only — ZERO real-world value
# It is COMPLETELY SEPARATE from the marketplace price (₹/hour)
DEMO_ESCROW_AMOUNT_WEI=1000000000000000

# ── Worker API ────────────────────────────────────────────────
# Shared secret for the Python GPU worker to authenticate with the backend.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_API_KEY=your_worker_api_key_here

# ── IPFS ─────────────────────────────────────────────────────
# If IPFS_API_URL is set, the backend connects to a real IPFS node.
# If not set, a local mock IPFS mode is used (files stored in backend/.ipfs-mock/).
# IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

