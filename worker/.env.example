# Backend URL is internal to Docker Compose. Use http://localhost:5000/api
# when running the worker directly from your machine.
BACKEND_URL=http://localhost:5000/api
WORKER_API_KEY=local-worker-key-change-me
POLL_INTERVAL_SECONDS=5
MIN_EXECUTION_TIME=2
MAX_EXECUTION_TIME=10

# The current worker simulates compute. Leave this false unless real Docker
# execution has been implemented and configured.
DOCKER_ENABLED=false
